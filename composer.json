{
    "name": "brzdaboy/buchlovska-spiz",
    "description": "Buchlovská spíž – uzavřené B2B tržiště místních zemědělců a školních jídelen.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "files": ["src/autoload.php"]
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8080 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    }
}
